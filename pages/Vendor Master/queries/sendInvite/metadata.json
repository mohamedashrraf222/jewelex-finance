      "encodeParamsToggle": true,
      "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"supported-color-schemes\" content=\"light dark\">\n<title>Vendor KYC Invitation</title>\n<style>\n  /* Lock colors so Gmail/Apple Mail/Outlook dark mode doesn't auto-invert and break contrast */\n  :root { color-scheme: light dark; supported-color-schemes: light dark; }\n  @media (prefers-color-scheme: dark) {\n    .email-bg { background-color:#ffffff !important; }\n    .email-card { background-color:#ffffff !important; }\n    .body-text { color:#4a4a4a !important; }\n    .heading-text { color:#1a1a1a !important; }\n    .ribbon-bg { background-color:#faf7ee !important; }\n    .ribbon-text { color:#8a7328 !important; }\n    .footer-text { color:#8a8a8a !important; }\n    .footer-subtext { color:#666666 !important; }\n  }\n  a[x-apple-data-detectors] { color:inherit !important; text-decoration:none !important; }\n</style>\n</head>\n<body class=\"email-bg\" style=\"margin:0; padding:0; background-color:#ffffff; font-family:'Segoe UI', Arial, sans-serif;\">\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" class=\"email-bg\" style=\"background-color:#ffffff;\">\n    <tr>\n      <td align=\"center\" style=\"padding:16px;\">\n\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" class=\"email-card\" style=\"background-color:#ffffff; max-width:100%; border-radius:16px; overflow:hidden; box-shadow:0 6px 24px rgba(0,0,0,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#0c0c0c; padding:20px 40px; text-align:center;\">\n              <div style=\"font-family:Georgia, 'Times New Roman', serif; font-size:9px; letter-spacing:4px; color:#d4af37; margin-bottom:6px; text-transform:uppercase;\">\n                &#10022;&nbsp;&nbsp;Est. Excellence in Fine Jewelry&nbsp;&nbsp;&#10022;\n              </div>\n              <div style=\"font-family:Georgia, 'Times New Roman', serif; font-size:20px; letter-spacing:3px; color:#ffffff; font-weight:bold;\">\n                JEWELEX <span style=\"color:#d4af37;\">GROUP</span>\n              </div>\n            </td>\n          </tr>\n\n          <!-- Gold accent line -->\n          <tr>\n            <td style=\"height:3px; background:linear-gradient(90deg, #0c0c0c, #d4af37, #f5e7a3, #d4af37, #0c0c0c);\"></td>\n          </tr>\n\n          <!-- Ribbon subtitle -->\n          <tr>\n            <td class=\"ribbon-bg\" style=\"background-color:#faf7ee; padding:14px 40px; text-align:center; border-bottom:1px solid #ece5d3;\">\n              <span class=\"ribbon-text\" style=\"font-size:13px; letter-spacing:2px; color:#8a7328; text-transform:uppercase; font-weight:600;\">\n                Vendor KYC &amp; Onboarding\n              </span>\n            </td>\n          </tr>\n\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:44px 44px 12px 44px;\">\n              <p class=\"heading-text\" style=\"font-size:17px; color:#1a1a1a; margin:0 0 20px 0; font-weight:600;\">\n                Dear {{vendorMasterWidget.model.newInvite.vendorName}} ,\n              </p>\n              <p class=\"body-text\" style=\"font-size:15px; line-height:1.75; color:#4a4a4a; margin:0 0 20px 0;\">\n                We're pleased to welcome you into the <strong>Jewelex Group</strong> vendor network. As part of our\n                onboarding process, we kindly request that you complete a short, secure KYC (Know Your Customer)\n                verification.\n              </p>\n              <p class=\"body-text\" style=\"font-size:15px; line-height:1.75; color:#4a4a4a; margin:0 0 32px 0;\">\n                This helps us maintain the highest standards of trust and compliance across our partner ecosystem,\n                and ensures a smooth path to purchase orders and payments going forward.\n              </p>\n\n              <!-- CTA Button -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td align=\"center\" style=\"padding-bottom:36px;\">\n                    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr>\n                        <td align=\"center\" style=\"border-radius:8px; background-color:#0c0c0c; box-shadow:0 4px 14px rgba(0,0,0,0.18);\">\n                          <a href=\"{{appsmith.URL.protocol + '//' + appsmith.URL.host}}/app/vendor-kyc/kyc-pending-6aa389f92795dc48d68c92cb\" target=\"_blank\" style=\"display:inline-block; padding:16px 48px; font-size:15px; font-weight:bold; color:#d4af37; text-decoration:none; letter-spacing:1px; text-transform:uppercase;\">\n                            Complete Your KYC &rarr;\n                          </a>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:1px solid #f0ece0; padding-top:0;\">\n                <tr>\n                  <td style=\"padding-top:28px;\">\n                    <p class=\"body-text\" style=\"font-size:14px; line-height:1.7; color:#555555; margin:0;\">\n                      Should you have any questions or need assistance at any step, our vendor relations team is happy\n                      to help at\n                      <a href=\"mailto:vendors@jewelexgroup.com\" style=\"color:#8a7328; text-decoration:none; font-weight:600;\">vendors@jewelexgroup.com</a>.\n                    </p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Signature -->\n          <tr>\n            <td style=\"padding:8px 44px 40px 44px;\">\n              <p class=\"heading-text\" style=\"font-size:14px; color:#1a1a1a; margin:0; line-height:1.6;\">\n                Warm regards,<br>\n                <strong>Vendor Relations Team</strong><br>\n                <span style=\"color:#8a7328;\">Jewelex Group</span>\n              </p>\n            </td>\n          </tr>\n\n          <!-- Gold accent line -->\n          <tr>\n            <td style=\"height:3px; background:linear-gradient(90deg, #0c0c0c, #d4af37, #f5e7a3, #d4af37, #0c0c0c);\"></td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color:#0c0c0c; padding:26px 40px; text-align:center;\">\n              <p class=\"footer-text\" style=\"font-size:11px; color:#8a8a8a; margin:0 0 6px 0; letter-spacing:0.5px;\">\n                &copy; 2026 Jewelex Group. All rights reserved.\n              </p>\n              <p class=\"footer-subtext\" style=\"font-size:10px; color:#666666; margin:0;\">\n                This is an automated message regarding your vendor onboarding. Please do not reply directly to this email.\n              </p>\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
