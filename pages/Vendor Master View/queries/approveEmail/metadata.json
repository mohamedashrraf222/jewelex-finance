      "encodeParamsToggle": true,
      "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"supported-color-schemes\" content=\"light dark\">\n<title>Vendor KYC Approved</title>\n<style>\n  :root { color-scheme: light dark; supported-color-schemes: light dark; }\n  @media (prefers-color-scheme: dark) {\n    .email-bg { background-color:#ffffff !important; }\n    .email-card { background-color:#ffffff !important; }\n    .body-text { color:#4a4a4a !important; }\n    .heading-text { color:#1a1a1a !important; }\n    .ribbon-bg { background-color:#eef7f0 !important; }\n    .ribbon-text { color:#1e7d3c !important; }\n    .detail-bg { background-color:#faf7ee !important; }\n    .detail-label { color:#8a7328 !important; }\n    .detail-value { color:#1a1a1a !important; }\n    .footer-text { color:#8a8a8a !important; }\n    .footer-subtext { color:#666666 !important; }\n  }\n  a[x-apple-data-detectors] { color:inherit !important; text-decoration:none !important; }\n</style>\n</head>\n<body class=\"email-bg\" style=\"margin:0; padding:0; background-color:#ffffff; font-family:'Segoe UI', Arial, sans-serif;\">\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" class=\"email-bg\" style=\"background-color:#ffffff;\">\n    <tr>\n      <td align=\"center\" style=\"padding:16px;\">\n\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" class=\"email-card\" style=\"background-color:#ffffff; max-width:100%; border-radius:16px; overflow:hidden; box-shadow:0 6px 24px rgba(0,0,0,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#0c0c0c; padding:20px 40px; text-align:center;\">\n              <div style=\"font-family:Georgia, 'Times New Roman', serif; font-size:9px; letter-spacing:4px; color:#d4af37; margin-bottom:6px; text-transform:uppercase;\">\n                &#10022;&nbsp;&nbsp;Est. Excellence in Fine Jewelry&nbsp;&nbsp;&#10022;\n              </div>\n              <div style=\"font-family:Georgia, 'Times New Roman', serif; font-size:20px; letter-spacing:3px; color:#ffffff; font-weight:bold;\">\n                JEWELEX <span style=\"color:#d4af37;\">GROUP</span>\n              </div>\n            </td>\n          </tr>\n\n          <!-- Gold accent line -->\n          <tr>\n            <td style=\"height:3px; background:linear-gradient(90deg, #0c0c0c, #d4af37, #f5e7a3, #d4af37, #0c0c0c);\"></td>\n          </tr>\n\n          <!-- Ribbon subtitle -->\n          <tr>\n            <td class=\"ribbon-bg\" style=\"background-color:#eef7f0; padding:14px 40px; text-align:center; border-bottom:1px solid #dcefe1;\">\n              <span class=\"ribbon-text\" style=\"font-size:13px; letter-spacing:2px; color:#1e7d3c; text-transform:uppercase; font-weight:600;\">\n                &#10003;&nbsp; KYC Verification &mdash; Approved\n              </span>\n            </td>\n          </tr>\n\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:44px 44px 12px 44px;\">\n              <p class=\"heading-text\" style=\"font-size:17px; color:#1a1a1a; margin:0 0 20px 0; font-weight:600;\">\n                Dear {{getVendorProfile.data[0].vendor_working_name}},\n              </p>\n              <p class=\"body-text\" style=\"font-size:15px; line-height:1.75; color:#4a4a4a; margin:0 0 20px 0;\">\n                We're pleased to let you know that your KYC (Know Your Customer) verification with the\n                <strong>Jewelex Group</strong> has been <strong>approved</strong>. You are now a verified vendor in\n                our partner network.\n              </p>\n              <p class=\"body-text\" style=\"font-size:15px; line-height:1.75; color:#4a4a4a; margin:0 0 28px 0;\">\n                You can now proceed with purchase orders and invoicing through the standard Jewelex process. Please\n                keep your bank and registration details up to date in case anything changes.\n              </p>\n\n              <!-- Detail box -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" class=\"detail-bg\" style=\"background-color:#faf7ee; border-radius:10px; margin-bottom:32px;\">\n                <tr>\n                  <td style=\"padding:18px 24px;\">\n                    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr>\n                        <td class=\"detail-label\" style=\"font-size:11px; letter-spacing:1px; color:#8a7328; text-transform:uppercase; padding-bottom:4px;\">Vendor</td>\n                      </tr>\n                      <tr>\n                        <td class=\"detail-value\" style=\"font-size:14px; color:#1a1a1a; font-weight:600; padding-bottom:12px;\">{{getVendorProfile.data[0].vendor_contact_email}}</td>\n                      </tr>\n                      <tr>\n                        <td class=\"detail-label\" style=\"font-size:11px; letter-spacing:1px; color:#8a7328; text-transform:uppercase; padding-bottom:4px;\">Approved On</td>\n                      </tr>\n                      <tr>\n                        <td class=\"detail-value\" style=\"font-size:14px; color:#1a1a1a; font-weight:600;\">{{new Date().toLocaleDateString('en-GB')}}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:1px solid #f0ece0; padding-top:0;\">\n                <tr>\n                  <td style=\"padding-top:28px;\">\n                    <p class=\"body-text\" style=\"font-size:14px; line-height:1.7; color:#555555; margin:0;\">\n                      Should you have any questions, our vendor relations team is happy to help at\n                      <a href=\"mailto:vendors@jewelexgroup.com\" style=\"color:#8a7328; text-decoration:none; font-weight:600;\">vendors@jewelexgroup.com</a>.\n                    </p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Signature -->\n          <tr>\n            <td style=\"padding:8px 44px 40px 44px;\">\n              <p class=\"heading-text\" style=\"font-size:14px; color:#1a1a1a; margin:0; line-height:1.6;\">\n                Warm regards,<br>\n                <strong>Vendor Relations Team</strong><br>\n                <span style=\"color:#8a7328;\">Jewelex Group</span>\n              </p>\n            </td>\n          </tr>\n\n          <!-- Gold accent line -->\n          <tr>\n            <td style=\"height:3px; background:linear-gradient(90deg, #0c0c0c, #d4af37, #f5e7a3, #d4af37, #0c0c0c);\"></td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color:#0c0c0c; padding:26px 40px; text-align:center;\">\n              <p class=\"footer-text\" style=\"font-size:11px; color:#8a8a8a; margin:0 0 6px 0; letter-spacing:0.5px;\">\n                &copy; 2026 Jewelex Group. All rights reserved.\n              </p>\n              <p class=\"footer-subtext\" style=\"font-size:10px; color:#666666; margin:0;\">\n                This is an automated message regarding your vendor onboarding. Please do not reply directly to this email.\n              </p>\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
