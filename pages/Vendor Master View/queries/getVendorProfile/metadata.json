          "data": "{\n  \"aggregate\": \"kyc_cases\",\n  \"pipeline\": [\n    {\n      \"$match\": {\n        \"_id\": \"{{appsmith.URL.queryParams.id}}\"\n      }\n    },\n    {\n      \"$limit\": 1\n    },\n    {\n      \"$addFields\": {\n        \"latest_submission\": {\n          \"$let\": {\n            \"vars\": {\n              \"sortedSubs\": {\n                \"$sortArray\": {\n                  \"input\": {\n                    \"$ifNull\": [\n                      \"$submissions\",\n                      []\n                    ]\n                  },\n                  \"sortBy\": {\n                    \"submitted_at\": -1\n                  }\n                }\n              }\n            },\n            \"in\": {\n              \"$first\": \"$$sortedSubs\"\n            }\n          }\n        }\n      }\n    },\n    {\n      \"$addFields\": {\n        \"resolved_submission_id\": {\n          \"$ifNull\": [\n            \"$latest_submission.submission_id\",\n            \"$current_draft.submission_id\"\n          ]\n        },\n        \"payload\": {\n          \"$ifNull\": [\n            \"$latest_submission.payload\",\n            \"$current_draft.payload\"\n          ]\n        }\n      }\n    },\n    {\n      \"$lookup\": {\n        \"from\": \"kyc_documents\",\n        \"let\": {\n          \"cid\": \"$_id\",\n          \"sid\": \"$resolved_submission_id\"\n        },\n        \"pipeline\": [\n          {\n            \"$match\": {\n              \"$expr\": {\n                \"$and\": [\n                  {\n                    \"$eq\": [\n                      \"$case_id\",\n                      \"$$cid\"\n                    ]\n                  },\n                  {\n                    \"$eq\": [\n                      \"$submission_id\",\n                      \"$$sid\"\n                    ]\n                  },\n                  {\n                    \"$eq\": [\n                      \"$draft_state\",\n                      \"ACTIVE\"\n                    ]\n                  }\n                ]\n              }\n            }\n          },\n          {\n            \"$sort\": {\n              \"uploaded_at\": -1\n            }\n          },\n          {\n            \"$project\": {\n              \"_id\": 1,\n              \"case_id\": 1,\n              \"submission_id\": 1,\n              \"document_type_code\": 1,\n              \"logical_slot\": 1,\n              \"original_filename\": 1,\n              \"scan_state\": 1,\n              \"uploaded_at\": 1,\n              \"extraction_current\": 1,\n              \"submission_frozen\": 1\n            }\n          }\n        ],\n        \"as\": \"active_documents\"\n      }\n    },\n    {\n      \"$lookup\": {\n        \"from\": \"kyc_documents\",\n        \"let\": {\n          \"docIds\": {\n            \"$ifNull\": [\n              \"$latest_submission.document_ids\",\n              []\n            ]\n          }\n        },\n        \"pipeline\": [\n          {\n            \"$match\": {\n              \"$expr\": {\n                \"$in\": [\n                  \"$_id\",\n                  \"$$docIds\"\n                ]\n              }\n            }\n          },\n          {\n            \"$project\": {\n              \"_id\": 1,\n              \"document_type_code\": 1,\n              \"original_filename\": 1,\n              \"uploaded_at\": 1\n            }\n          }\n        ],\n        \"as\": \"frozen_documents\"\n      }\n    },\n    {\n      \"$project\": {\n        \"_id\": 1,\n        \"vendor_working_name\": 1,\n        \"vendor_contact_email\": 1,\n        \"party_type\": 1,\n        \"category\": 1,\n        \"service_supplier\": 1,\n        \"status\": 1,\n        \"current_submission_version\": 1,\n        \"lock_version\": 1,\n        \"current_draft\": 1,\n        \"latest_submission\": 1,\n        \"payload\": 1,\n        \"active_documents\": 1,\n        \"frozen_documents\": 1,\n        \"submissions\": 1,\n  